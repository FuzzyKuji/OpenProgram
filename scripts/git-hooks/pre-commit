#!/bin/sh
# Installed into .git/hooks by scripts/publish-github.sh.
# Local main is the slow line GitHub carries; it only takes squashed versions
# from scripts/publish-github.sh. Everyday commits go to dev.
if test "$(git symbolic-ref -q HEAD)" = "refs/heads/main"; then
  echo "committing on main is refused: commit on dev; main only takes versions from scripts/publish-github.sh" >&2
  exit 1
fi
exit 0
